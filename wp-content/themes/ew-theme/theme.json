{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "typography": {
      "customFontSize": false,
      "letterSpacing": true,
      "lineHeight": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "name": "Primary",
          "slug": "primary",
          "fontFamily": "'Raleway', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Raleway",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/Raleway/Raleway-Regular.woff2"
              ]
            },
            {
              "fontFamily": "Raleway",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/Raleway/Raleway-Bold.woff2"
              ]
            },
            {
              "fontFamily": "Raleway",
              "fontWeight": "400",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/Raleway/Raleway-Italic.woff2"
              ]
            },
            {
              "fontFamily": "Raleway",
              "fontWeight": "700",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/Raleway/Raleway-BoldItalic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "size": "48px",
          "name": "Headline 1",
          "slug": "h1"
        },
        {
          "size": "40px",
          "name": "Headline 2",
          "slug": "h2"
        },
        {
          "size": "32px",
          "name": "Headline 3",
          "slug": "h3"
        },
        {
          "size": "24px",
          "name": "Headline 4",
          "slug": "h4"
        },
        {
          "size": "20px",
          "name": "Headline 5",
          "slug": "h5"
        },
        {
          "size": "18px",
          "name": "Headline 6",
          "slug": "h6"
        },
        {
          "size": "18px",
          "name": "Text 1",
          "slug": "b1"
        },
        {
          "size": "16px",
          "name": "Text 2",
          "slug": "b2"
        },
        {
          "size": "14px",
          "name": "Text 3",
          "slug": "b3"
        },
        {
          "size": "12px",
          "name": "Note",
          "slug": "n1"
        },
        {
          "size": "12px",
          "name": "Label",
          "slug": "l1"
        },
        {
          "size": "18px",
          "name": "Subheadline",
          "slug": "sh1"
        }
      ]
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "palette": [
        {
          "name": "Black",
          "slug": "black",
          "color": "#121213"
        },
        {
          "name": "Dark grey",
          "slug": "dark-grey",
          "color": "#404047"
        },
        {
          "name": "Charcoal",
          "slug": "charcoal",
          "color": "#6A6B71"
        },
        {
          "name": "Cool Grey",
          "slug": "cool-grey",
          "color": "#9D9FA8"
        },
        {
          "name": "Platinum",
          "slug": "platinum",
          "color": "#E3E2E2"
        },
        {
          "name": "Silk",
          "slug": "silk",
          "color": "#E3E2E2"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Blue Dark",
          "slug": "blue-dark",
          "color": "#2350B3"
        },
        {
          "name": "Blue Base",
          "slug": "blue-base",
          "color": "#3669D9"
        },
        {
          "name": "Blue Light",
          "slug": "blue-light",
          "color": "#5E87E1"
        },
        {
          "name": "Blue Bleached",
          "slug": "blue-bleached",
          "color": "#DFE7F9"
        },
        {
          "name": "Blue Bleached Light",
          "slug": "blue-bleached-light",
          "color": "#EFF3FC"
        },
        {
          "name": "Red Light",
          "slug": "red-light",
          "color": "#E75353"
        },
        {
          "name": "Red Dark",
          "slug": "red-dark",
          "color": "#DC4444"
        },
        {
          "name": "Red Bleached",
          "slug": "red-bleached",
          "color": "#FFE9E5"
        },
        {
          "name": "Red Bleached Light",
          "slug": "red-bleached-light",
          "color": "#FCF1EF"
        },
        {
          "name": "Green Light",
          "slug": "green-light",
          "color": "#42A85F"
        },
        {
          "name": "Green Dark",
          "slug": "green-dark",
          "color": "#2D8F48"
        },
        {
          "name": "Green Bleached",
          "slug": "green-bleached",
          "color": "#D8EDDA"
        },
        {
          "name": "Green Bleached Light",
          "slug": "green-bleached-light",
          "color": "#E4F7E6"
        }
      ],
      "gradients": [
        {
          "name": "Dark Sky",
          "slug": "dark-sky",
          "gradient": "linear-gradient(180deg, #D2D4FF 0%, #272A71 100%)"
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "size": "4px",
          "name": "5X-Small",
          "slug": "5-x-small"
        },
        {
          "size": "8px",
          "name": "4X-Small",
          "slug": "4-x-small"
        },
        {
          "size": "12px",
          "name": "3X-Small",
          "slug": "3-x-small"
        },
        {
          "size": "16px",
          "name": "2X-Small",
          "slug": "2-x-small"
        },
        {
          "size": "20px",
          "name": "X-Small",
          "slug": "x-small"
        },
        {
          "size": "24px",
          "name": "Small",
          "slug": "small"
        },
        {
          "size": "32px",
          "name": "Medium",
          "slug": "medium"
        },
        {
          "size": "48px",
          "name": "Large",
          "slug": "large"
        },
        {
          "size": "64px",
          "name": "X-Large",
          "slug": "x-large"
        },
        {
          "size": "80px",
          "name": "2X-Large",
          "slug": "2-x-large"
        },
        {
          "size": "160px",
          "name": "3X-Large",
          "slug": "3-x-large"
        },
        {
          "size": "240px",
          "name": "4X-Large",
          "slug": "4-x-large"
        }
      ]
    },
    "layout": {
      "wideSize": "var:custom|layout|wide-size",
      "contentSize": "var:custom|layout|content-size",
      "allowEditing": true,
      "allowCustomContentAndWideSize": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Blur Medium",
          "slug": "blur-medium",
          "shadow": "1px 4px 8px 0px rgba(18, 18, 19, 0.16)"
        },
        {
          "name": "Blur Large",
          "slug": "blur-large",
          "shadow": "2px 6px 20px 0px rgba(18, 18, 19, 0.20)"
        },
        {
          "name": "Blur X-Large",
          "slug": "blur-x-large",
          "shadow": "2px 6px 40px 0px rgba(18, 18, 19, 0.20)"
        }
      ]
    },
    "lightbox": {
      "allowEditing": true,
      "enabled": false
    },
    "custom": {
      "lineHeight": {
        "small": "16px",
        "medium": "18px",
        "large": "24px",
        "x-large": "30px",
        "2x-large": "40px",
        "3x-large": "56px",
        "4x-large": "72px"
      },
      "letterSpacing": {
        "small": "-0.2px",
        "medium": "0px",
        "large": "0.2px",
        "x-large": "0.4px",
        "2x-large": "0.8px",
        "3x-large": "1px",
        "4x-large": "1.4px"
      },
      "border": {
        "radius": {
          "small": "8px",
          "medium": "16px",
          "large": "24px"
        }
      },
      "breakpoint": {
        "tablet": "834px",
        "mobile": "500px"
      },
      "layout": {
        "wideSize": "1684px",
        "contentSize": "888px",
        "containerPadding": "80px"
      },
      "zIndex": {
        "navbar": 10
      }
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|b-2",
      "lineHeight": "var:custom|line-height|medium",
      "letterSpacing": "var:custom|letter-spacing|medium",
      "fontStyle": "normal",
      "fontWeight": "400"
    },
    "color": {
      "text": "var:preset|color|black"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontWeight": "700"
        },
        "color": {
          "text": "var:preset|color|black"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|h-1",
          "lineHeight": "var:custom|line-height|3-x-large",
          "letterSpacing": "var:custom|letter-spacing|large"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|medium",
            "bottom": "var:preset|spacing|medium"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|h-2",
          "lineHeight": "var:custom|line-height|2-x-large",
          "letterSpacing": "var:custom|letter-spacing|large"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|small",
            "bottom": "var:preset|spacing|medium"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|h-3",
          "lineHeight": "var:custom|line-height|x-large",
          "letterSpacing": "var:custom|letter-spacing|large"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|2-x-small",
            "bottom": "var:preset|spacing|2-x-small"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|h-4",
          "lineHeight": "var:custom|line-height|x-large",
          "letterSpacing": "var:custom|letter-spacing|medium"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|3-x-small",
            "bottom": "var:preset|spacing|3-x-small"
          }
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|h-5",
          "lineHeight": "var:custom|line-height|large",
          "letterSpacing": "var:custom|letter-spacing|3-x-large"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|4-x-small",
            "bottom": "var:preset|spacing|4-x-small"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|h-6",
          "lineHeight": "var:custom|line-height|medium",
          "letterSpacing": "var:custom|letter-spacing|small"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|4-x-small",
            "bottom": "var:preset|spacing|4-x-small"
          }
        }
      },
      "link": {
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "lineHeight": "var:custom|line-height|large",
          "letterSpacing": "var:custom|letter-spacing|medium",
          "textDecoration": "underline",
          "fontWeight": "700"
        },
        "color": {
          "text": "var:preset|color|blue-base"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|blue-dark"
          }
        },
        ":active": {
          "color": {
            "text": "var:preset|color|blue-base"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "var:custom|border|radius|small",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|blue-base"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "letterSpacing": "var:custom|letter-spacing|large",
          "fontSize": "18px",
          "lineHeight": "var:custom|line-height|large",
          "textDecoration": "none",
          "fontWeight": "700"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|3-x-small",
            "right": "var:preset|spacing|small",
            "bottom": "var:preset|spacing|3-x-small",
            "left": "var:preset|spacing|small"
          },
          "margin": {
            "top": "var:preset|spacing|small",
            "bottom": "var:preset|spacing|small"
          }
        },
        "color": {
          "background": "var:preset|color|blue-base",
          "text": "var:preset|color|white"
        },
        "css": "user-select: none; transition: background 100ms ease-in-out, color 100ms ease-in-out; &:hover { color: var(--wp--preset--color--blue-bleached-light); background-color: var(--wp--preset--color--blue-dark); border-color: var(--wp--preset--color--blue-dark); } &:active { color: var(--wp--preset--color--blue-bleached-light); background-color: var(--wp--preset--color--blue-light); border-color: var(--wp--preset--color--blue-light); } &:disabled { color: var(--wp--preset--color--cool-grey); background-color: var(--wp--preset--color--silk); border-color: var(--wp--preset--color--silk); }",
        "variations": {
          "outline": {
            "border": {
              "radius": "var:custom|border|radius|small",
              "width": "1px",
              "style": "solid",
              "color": "var:preset|color|blue-base"
            },
            "typography": {
              "fontFamily": "var:preset|font-family|primary",
              "letterSpacing": "var:custom|letter-spacing|large",
              "fontSize": "18px",
              "lineHeight": "var:custom|line-height|large",
              "textDecoration": "none",
              "fontWeight": "700"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|3-x-small",
                "right": "var:preset|spacing|small",
                "bottom": "var:preset|spacing|3-x-small",
                "left": "var:preset|spacing|small"
              },
              "margin": {
                "top": "var:preset|spacing|small",
                "bottom": "var:preset|spacing|small"
              }
            },
            "color": {
              "background": "transparent",
              "text": "var:preset|color|blue-base"
            },
            "css": "user-select: none; transition: background 100ms ease-in-out, color 100ms ease-in-out; &:hover { color: var(--wp--preset--color--blue-dark); background-color: var(--wp--preset--color--blue-bleached-light); border-color: var(--wp--preset--color--blue-dark); } &:active { color: var(--wp--preset--color--blue-light); background-color: var(--wp--preset--color--blue-bleached); border-color: var(--wp--preset--color--blue-base); } &:disabled { color: var(--wp--preset--color--cool-grey); background-color: transparent; border-color: var(--wp--preset--color--cool-grey); }"
          },
          "text": {
            "border": {
              "radius": "var:custom|border|radius|small",
              "width": "1px",
              "style": "solid",
              "color": "transparent"
            },
            "typography": {
              "fontFamily": "var:preset|font-family|primary",
              "letterSpacing": "var:custom|letter-spacing|large",
              "fontSize": "18px",
              "lineHeight": "var:custom|line-height|large",
              "textDecoration": "none",
              "fontWeight": "700"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|3-x-small",
                "right": "var:preset|spacing|small",
                "bottom": "var:preset|spacing|3-x-small",
                "left": "var:preset|spacing|small"
              },
              "margin": {
                "top": "var:preset|spacing|small",
                "bottom": "var:preset|spacing|small"
              }
            },
            "color": {
              "background": "transparent",
              "text": "var:preset|color|blue-base"
            },
            "css": "user-select: none; transition: background 100ms ease-in-out, color 100ms ease-in-out; &:hover { color: var(--wp--preset--color--blue-dark); background-color: var(--wp--preset--color--blue-bleached-light); border-color: var(--wp--preset--color--blue-bleached-light); } &:active { color: var(--wp--preset--color--blue-light); background-color: var(--wp--preset--color--blue-bleached); border-color: var(--wp--preset--color--blue-bleached); } &:disabled { color: var(--wp--preset--color--cool-grey); background-color: transparent; border-color: transparent; }"
          },
          "fill-medium": {
            "border": {
              "radius": "var:custom|border|radius|small",
              "width": "1px",
              "style": "solid",
              "color": "var:preset|color|blue-base"
            },
            "typography": {
              "fontFamily": "var:preset|font-family|primary",
              "letterSpacing": "var:custom|letter-spacing|large",
              "fontSize": "16px",
              "lineHeight": "var:custom|line-height|large",
              "textDecoration": "none",
              "fontWeight": "700"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|4-x-small",
                "right": "var:preset|spacing|x-small",
                "bottom": "var:preset|spacing|4-x-small",
                "left": "var:preset|spacing|x-small"
              },
              "margin": {
                "top": "var:preset|spacing|2-x-small",
                "bottom": "var:preset|spacing|2-x-small"
              }
            },
            "color": {
              "background": "var:preset|color|blue-base",
              "text": "var:preset|color|white"
            },
            "css": "user-select: none; transition: background 100ms ease-in-out, color 100ms ease-in-out; &:hover { color: var(--wp--preset--color--blue-bleached-light); background-color: var(--wp--preset--color--blue-dark); border-color: var(--wp--preset--color--blue-dark); } &:active { color: var(--wp--preset--color--blue-bleached-light); background-color: var(--wp--preset--color--blue-light); border-color: var(--wp--preset--color--blue-light); } &:disabled { color: var(--wp--preset--color--cool-grey); background-color: var(--wp--preset--color--silk); border-color: var(--wp--preset--color--silk); }"
          }
        }
      }
    }
  }
}
